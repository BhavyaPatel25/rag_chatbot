# --- Chat: Ollama Cloud ---
OLLAMA_HOST=https://api.ollama.ai
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:cloud

# --- Embeddings: OpenAI (hosted, works from Render with no local model) ---
EMBEDDINGS_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-large

# --- Optional: local Ollama embeddings instead of OpenAI ---
# EMBEDDINGS_PROVIDER=ollama
# EMBED_HOST=http://localhost:11434
# OLLAMA_EMBED_MODEL=embeddinggemma:300m
