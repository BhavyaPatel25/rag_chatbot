# --- Chat: Ollama Cloud (native API, base https://ollama.com) ---
# The ollama client appends /api/chat -> https://ollama.com/api/chat
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:cloud
OLLAMA_CHAT_MODE=native

# --- Embeddings: OpenAI (hosted, works from Render, no local model) ---
EMBEDDINGS_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-large

# --- Fallback chat modes (no code change needed) ---
# OLLAMA_CHAT_MODE=openai_compat  -> OpenAI lib -> https://ollama.com/v1 (Ollama Cloud OpenAI-compat)
# OLLAMA_CHAT_MODE=openai         -> OpenAI lib -> api.openai.com, model OPENAI_CHAT_MODEL (default gpt-4o-mini)

# --- Optional: local Ollama embeddings instead of OpenAI ---
# EMBEDDINGS_PROVIDER=ollama
# EMBED_HOST=http://localhost:11434
# OLLAMA_EMBED_MODEL=embeddinggemma:300m
